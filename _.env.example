# Copy of the values setup.sh / setup.ps1 write into .env on first run.
# You normally do not need to create this file yourself. Never commit the real .env.

# User and group the containers run as (setup.sh uses your own `id -u` / `id -g`)
PUID=1000
PGID=1000

# Timezone in IANA format
TZ=Europe/London

# qBittorrent web UI login (the script generates a random password if QBIT_PASS is missing)
QBIT_USER=admin
QBIT_PASS=change-me

# Optional: where torrents and media live (default: ./data)
# DATA_DIR=/Volumes/Media/data

# Optional: claim the Plex server on first start (https://plex.tv/claim, valid ~4 minutes)
# PLEX_CLAIM=claim-xxxxxxxxxxxxxxxxxxxx

# Hosts the dashboard may be opened from (the script refreshes this each run)
HOMEPAGE_ALLOWED_HOSTS=localhost:3000,127.0.0.1:3000
